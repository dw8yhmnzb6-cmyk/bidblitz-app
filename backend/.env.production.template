"""
BidBlitz V2 - Production Environment Template
Copy to .env.production and fill in real values
"""

# ══════════════════════════════════════
# ENVIRONMENT
# ══════════════════════════════════════
APP_ENV=production
DEBUG=false

# ══════════════════════════════════════
# DATABASE
# ══════════════════════════════════════
# MongoDB Atlas or self-hosted with replica set
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bidblitz_production

# ══════════════════════════════════════
# AUTHENTICATION
# ══════════════════════════════════════
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ══════════════════════════════════════
# STRIPE (LIVE KEYS)
# ══════════════════════════════════════
# Get from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_REPLACE_WITH_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ══════════════════════════════════════
# DOMAIN & URLS
# ══════════════════════════════════════
FRONTEND_URL=https://app.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ══════════════════════════════════════
# SECURITY
# ══════════════════════════════════════
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ══════════════════════════════════════
# MONITORING (Optional)
# ══════════════════════════════════════
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=INFO

# ══════════════════════════════════════
# EMAIL (Optional - for notifications)
# ══════════════════════════════════════
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxx
# FROM_EMAIL=noreply@yourdomain.com
