<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>BidBlitz</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>BidBlitz benötigt die Kamera, um QR-Codes am POS zu scannen, Ausweis-Bilder für die KYC-Verifikation aufzunehmen und Profilbilder zu ändern.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BidBlitz speichert Belege und Auktionsbilder und lädt optional Fotos für Marketplace-Inserate hoch.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BidBlitz speichert digitale Belege in deiner Fotomediathek.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BidBlitz nutzt deinen Standort für Taxi-Bestellungen, Händler in der Nähe, Stadt-Autocomplete und Lieferverfolgung.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>BidBlitz nutzt deinen Standort im Hintergrund, damit Kids-GPS-Tracking und Live-Lieferungen funktionieren.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>BidBlitz verwendet Face ID zur Absicherung deines Logins und Zahlungsbestätigungen.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BidBlitz Staff erkennt Bluetooth-Beacons am Arbeitsplatz, um deine Schicht automatisch zu starten.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>BidBlitz Staff nutzt Bluetooth, um deine Anwesenheit am Arbeitsplatz zu erkennen.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>BidBlitz Staff erkennt das WLAN am Arbeitsplatz, um deine Schicht automatisch zu starten.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
