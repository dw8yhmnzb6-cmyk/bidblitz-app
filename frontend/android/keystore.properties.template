# BidBlitz Android Release Keystore — TEMPLATE
# =============================================
# 1. Generate a keystore (keep it in a SAFE location, never commit):
#
#    keytool -genkey -v \
#      -keystore bidblitz-upload.jks \
#      -alias bidblitz \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy bidblitz-upload.jks into /app/frontend/android/
# 3. Copy this file to /app/frontend/android/keystore.properties
#    and fill in the real values. That file is git-ignored.
#
# Required env vars for CI (alternative to file):
#   ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#
# WARNING: Losing the keystore = you can never update the app on Play Store.
# Back it up off-site before the first release.

storeFile=bidblitz-upload.jks
storePassword=CHANGE_ME
keyAlias=bidblitz
keyPassword=CHANGE_ME
