# BidBlitz Off-Site Backup configuration
# Copy to /etc/bidblitz/backup.env and edit (chmod 600).
# Used by /var/www/bidblitz/deploy/backup_offsite.sh

# ─── Mongo ──────────────────────────────────────────────────────────────────
MONGO_URL="mongodb://localhost:27017"
DB_NAME="bidblitz"

# ─── Local staging ──────────────────────────────────────────────────────────
BACKUP_LOCAL_DIR="/var/backups/bidblitz"
BACKUP_RETAIN_DAYS="30"
APP_DIR="/var/www/bidblitz"

# ─── Remote target (Hetzner Storage Box recommended) ────────────────────────
# Order one at https://www.hetzner.com/storage/storage-box (~ €3.49/Mo for 1TB)
# After purchase, in Robot Console: enable SSH support, add your VPS public key.
#
# Hetzner Storage Box uses port 23 (SSH) and a restricted shell.
BACKUP_REMOTE_HOST="uXXXXXX.your-storagebox.de"
BACKUP_REMOTE_USER="uXXXXXX"
BACKUP_REMOTE_PORT="23"
BACKUP_REMOTE_PATH="/home/bidblitz-prod"
BACKUP_SSH_KEY="/root/.ssh/bidblitz_backup_ed25519"
