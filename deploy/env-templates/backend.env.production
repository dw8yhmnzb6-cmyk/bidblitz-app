APP_ENV=production
MONGO_URL=mongodb://localhost:27017
DB_NAME=bidblitz_production
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET_WITH_openssl_rand_hex_64
ADMIN_EMAIL=admin@bidblitz.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
STRIPE_API_KEY=sk_live_CHANGE_ME_YOUR_STRIPE_LIVE_KEY

# Central BidBlitz Admin / project SSO
BIDBLITZ_OWNER_ID=bidblitz-owner-primary
BIDBLITZ_OWNER_EMAILS=admin@bidblitz.ae
# Login aliases resolve to the same canonical admin record; they are not users.
BIDBLITZ_OWNER_LOGIN_ALIASES=afrimk@me.com
# Generate independent random values of at least 32 bytes. Never reuse one
# child project's SSO secret for another project.
BIDBLITZ_SSO_EYES_SECRET=
BIDBLITZ_SSO_TRADE_SECRET=
BIDBLITZ_SSO_AION_SECRET=

# Enable child-project SSO only after the corresponding project is deployed and mapped.
BIDBLITZ_SSO_EYES_ENABLED=false
BIDBLITZ_SSO_TRADE_ENABLED=false
BIDBLITZ_SSO_AION_ENABLED=false
BIDBLITZ_AION_BASE_URL=
