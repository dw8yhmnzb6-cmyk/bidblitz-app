[Unit]
Description=BidBlitz V2 Backend API
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/bidblitz-new/backend
EnvironmentFile=/var/www/bidblitz-new/backend/.env
ExecStart=/var/www/bidblitz-new/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --workers 2 --log-level info
Restart=always
RestartSec=5
StandardOutput=append:/var/www/bidblitz-new/logs/backend.log
StandardError=append:/var/www/bidblitz-new/logs/backend_error.log

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/www/bidblitz-new/logs

[Install]
WantedBy=multi-user.target
