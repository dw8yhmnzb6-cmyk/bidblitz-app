{
  "name": "bidblitz-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "npm --workspace frontend run start",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace frontend run test",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:ios": "npx cap open ios",
    "cap:open:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "postinstall": "node -e \"try{const path=require.resolve(\\\"patch-package/dist/index.js\\\");require(\\\"child_process\\\").execFileSync(process.execPath,[path,\\\"--patch-dir\\\",\\\"frontend/patches\\\"],{stdio:\\\"inherit\\\"});}catch(e){console.log(\\\"patch-package bootstrap skipped\\\")}\""
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.6.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "@capacitor/ios": "^7.6.2",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capawesome/capacitor-app-update": "7.2.0",
    "@capgo/camera-preview": "7.26.4",
    "@capgo/capacitor-health": "^7.2.15",
    "@capgo/capacitor-wifi": "7.0.3",
    "capacitor-native-settings": "7.0.2"
  },
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  }
}
